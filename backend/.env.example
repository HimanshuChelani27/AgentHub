# Copy to backend/.env. Everything is optional for local use.

# One LLM key switches the agents from scripted to LLM-written output (first set wins: Anthropic, Google, Groq, OpenAI).
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AGENTHUB_LLM_MODEL=gemini-flash-lite-latest

# Required changes for anything public:
# AGENTHUB_JWT_SECRET=<long random string>
# AGENTHUB_ADMIN_PASSWORD=<strong password>
# AGENTHUB_CREW_API_KEY=ah_<random string>
# AGENTHUB_CORS_ORIGINS=["https://your-dashboard.example.com"]
